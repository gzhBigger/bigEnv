{
  "name": "bigenv",
  "productName": "bigEnv",
  "version": "0.1.0",
  "private": true,
  "description": "bigEnv — 桌面端多语言运行环境管理器",
  "author": "bigEnv",
  "license": "MIT",
  "type": "module",
  "main": "out/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && node scripts/start.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dist": "npm run build && electron-builder --win",
    "verify-notes": "npx tsx \"C:/Users/gzh33/.agents/skills/write-notes-like-deepseek/scripts/verify-agent-note-tree.ts\" && npx tsx \"C:/Users/gzh33/.agents/skills/write-notes-like-deepseek/scripts/verify-agent-note-format.ts\" && npx tsx \"C:/Users/gzh33/.agents/skills/write-notes-like-deepseek/scripts/verify-archived-agent-notes.ts\"",
    "icon": "electron scripts/make-icon.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ]
  },
  "dependencies": {
    "smol-toml": "^1.4.2",
    "tar": "^7.5.22",
    "undici": "^7.16.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar": "^7.0.87",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  },
  "build": {
    "appId": "dev.bigenv.app",
    "productName": "bigEnv",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "out/cli.cjs",
        "to": "cli.cjs"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "bigEnv"
    }
  }
}
